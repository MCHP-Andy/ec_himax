/ {
    chosen {
        zephyr,shell-uart = &uart1;
    };

    aliases {
        led0 = &led4;
    };

    leds {
        compatible = "gpio-leds";
        led4: led_0 {
            gpios = <MCHP_GPIO_DECODE_153 GPIO_ACTIVE_HIGH>;
        };
    };

    soc {
        /delete-node/ i3c@40010800;

        i3c0: i3c@40010800 {
			// compatible = "snps,designware-i3c";
			// #address-cells = < 0x3 >;
			// #size-cells = < 0x0 >;
			// reg = < 0x40010800 0x800 >;
			// interrupts = < 0xb5 0x2 >;
			// input-clock-frequency = < 0xb71b000 >;
			// i3c-scl-hz = < 0xbebc20 >;
			// i2c-scl-hz = < 0x61a80 >;
			// status = "disabled";

            compatible = "microchip,mchp-i3c";
            #address-cells = <3>;
            #size-cells = <0>;
            reg = <0x40010800 0x300>,
                  <0x40010B00 0x018>;
            interrupts = <181 2>;
            girqs = <MCHP_XEC_ECIA_GIRQ_ENC(13, 8)>;
            pcr-scr = <MCHP_XEC_SCR_ENCODE(4, 25)>;
            input-clock-frequency = < DT_FREQ_M(192) >;
            i3c-scl-hz = <DT_FREQ_K(2000)>;
            i2c-scl-hz = <DT_FREQ_K(400)>;

            port-sel = <1>;
            pinctrl-0 = <&i3c01_sda_host_gpio012 &i3c01_scl_host_gpio013>; // TP257
	        pinctrl-names = "default";

            status = "okay";
		};
    };
};

&pinctrl {
    /omit-if-no-ref/ i3c01_sda_host_gpio012: i3c01_sda_host_gpio012 {
		pinmux = < MCHP_XEC_PINMUX(0012, MCHP_AF5) >;
	};

    /omit-if-no-ref/ i3c01_scl_host_gpio013: i3c01_scl_host_gpio013 {
		pinmux = < MCHP_XEC_PINMUX(0013, MCHP_AF5) >;
	};
};
