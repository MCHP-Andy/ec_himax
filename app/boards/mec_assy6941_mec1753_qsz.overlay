/ {
    chosen {
        zephyr,shell-uart = &uart1;
    };

    aliases {
        led0 = &led4;
    };

    zephyr,user {
        himax-wk-gpios = <MCHP_GPIO_DECODE_140 GPIO_ACTIVE_HIGH>;
    };

    leds {
        compatible = "gpio-leds";
        led4: led_0 {
            gpios = <MCHP_GPIO_DECODE_153 GPIO_ACTIVE_HIGH>;
        };
    };

    soc {
        /delete-node/ i3c@40010800;
        i3c0: i3c@40010800 {
            compatible = "microchip,mchp-i3c";
            #address-cells = <3>;
            #size-cells = <0>;
            reg = <0x40010800 0x300>,
                  <0x40010B00 0x018>;
            interrupts = <181 2>;
            girqs = <MCHP_XEC_ECIA_GIRQ_ENC(13, 8)>;
            pcr-scr = <MCHP_XEC_SCR_ENCODE(4, 25)>;
            input-clock-frequency = < DT_FREQ_M(192) >;
            i3c-scl-hz = <DT_FREQ_K(2000)>;
            i2c-scl-hz = <DT_FREQ_K(400)>;

            // port-sel = <0>;
            // pinctrl-0 = <&i3c00_sda_host_gpio132 &i3c00_scl_host_gpio140>; // TP252
            port-sel = <1>;
            pinctrl-0 = <&i3c01_sda_host_gpio012 &i3c01_scl_host_gpio013>; // TP257
	        pinctrl-names = "default";

            status = "okay";
		};

        /delete-node/ i3c@40010000;
        i3c1: i3c@40010000 {
            compatible = "microchip,mchp-i3c";
            #address-cells = <3>;
            #size-cells = <0>;
            reg = <0x40010000 0x400>,
                  <0x40010400 0x02C>;
            interrupts = <182 2>;
            girqs = <MCHP_XEC_ECIA_GIRQ_ENC(13, 9)>;
            pcr-scr = <MCHP_XEC_SCR_ENCODE(4, 26)>;
            input-clock-frequency = < DT_FREQ_M(192) >;
            i3c-scl-hz = <DT_FREQ_K(2000)>;
            i2c-scl-hz = <DT_FREQ_K(400)>;

            port-sel = <0>;
            pinctrl-0 = <&i3c00_sda_target_gpio132 &i3c00_scl_target_gpio140>; // TP252
            // port-sel = <1>;
            // pinctrl-0 = <&i3c01_sda_target_gpio012 &i3c01_scl_target_gpio013>; // TP257
	        pinctrl-names = "default";

            status = "disabled";
		};
    };
};

&i3c0 {
    himax_dev: himax_dev@20000002c400130000 {
        compatible = "microchip,i3c-fake-target";
        reg = < 0x20 0x02C4 0x00130000 >;
        /* Dynamic Address To Be Assigned To The Device */
        // assigned-address = <0x5C>;
        // supports-setaasa;
        status = "okay";
    };
};

&pinctrl {
    // I3C host pins
    /omit-if-no-ref/ i3c00_sda_host_gpio132: i3c00_sda_host_gpio132 {
		pinmux = < MCHP_XEC_PINMUX(0132, MCHP_AF2) >;
	};

    /omit-if-no-ref/ i3c00_scl_host_gpio140: i3c00_scl_host_gpio140 {
		pinmux = < MCHP_XEC_PINMUX(0140, MCHP_AF2) >;
	};

    /omit-if-no-ref/ i3c01_sda_host_gpio012: i3c01_sda_host_gpio012 {
		pinmux = < MCHP_XEC_PINMUX(0012, MCHP_AF5) >;
	};

    /omit-if-no-ref/ i3c01_scl_host_gpio013: i3c01_scl_host_gpio013 {
		pinmux = < MCHP_XEC_PINMUX(0013, MCHP_AF5) >;
	};

    // I3C target pins
    /omit-if-no-ref/ i3c00_sda_target_gpio132: i3c00_sda_target_gpio132 {
		pinmux = < MCHP_XEC_PINMUX(0132, MCHP_AF3) >;
	};

    /omit-if-no-ref/ i3c00_scl_target_gpio140: i3c00_scl_target_gpio140 {
		pinmux = < MCHP_XEC_PINMUX(0140, MCHP_AF3) >;
	};

    /omit-if-no-ref/ i3c01_sda_target_gpio012: i3c01_sda_target_gpio012 {
		pinmux = < MCHP_XEC_PINMUX(0012, MCHP_AF6) >;
	};

    /omit-if-no-ref/ i3c01_scl_target_gpio013: i3c01_scl_target_gpio013 {
		pinmux = < MCHP_XEC_PINMUX(0013, MCHP_AF6) >;
	};
};
