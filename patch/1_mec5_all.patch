diff --git a/samples/boards/mchp_mec5/i2c/prj.conf b/samples/boards/mchp_mec5/i2c/prj.conf
index 9f0782b8805..b39a6866a4d 100644
--- a/samples/boards/mchp_mec5/i2c/prj.conf
+++ b/samples/boards/mchp_mec5/i2c/prj.conf
@@ -14,7 +14,9 @@ CONFIG_LED=y
 CONFIG_SERIAL=y
 CONFIG_CONSOLE=y
 CONFIG_UART_CONSOLE=y
+CONFIG_DMA=y
 CONFIG_I2C=y
