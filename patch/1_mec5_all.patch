+# Microchip MEC5 QSPI
+
+# Copyright (c) 2024 Microchip Technology Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+config SPI_MEC5_QSPI
+	bool "Microchip MEC5 QSPI driver"
+	default y
