+static int espi_mec5_manage_callback(const struct device *dev,
+				     struct espi_callback *callback,
+				     bool set)
+{
+	struct espi_mec5_data *const data = dev->data;
+
+	return espi_manage_callback(&data->callbacks, callback, set);
+}
