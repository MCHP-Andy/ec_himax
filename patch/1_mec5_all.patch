 5 files changed, 706 insertions(+)
 create mode 100644 drivers/dma/Kconfig.mec5
 create mode 100644 drivers/dma/dma_mchp_mec5.c
 create mode 100644 dts/bindings/dma/microchip,mec5-dmac.yaml

