+	temp = (cap >> 4) & 0x7u;
+	LOG_INF("  b[6:4] = Max Supported Payload size = %u", temp);
+	pr_payload_size(temp, 1);
+	temp = (cap >> 8) & 0x7u;
+	LOG_INF("  b[6:4] = Max Selected Payload size = %u", temp);
+	pr_payload_size(temp, 1);
+}
