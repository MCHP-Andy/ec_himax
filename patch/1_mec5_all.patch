+	sirq-names = "ec_obf";
+	status = "disabled";
+};
+espi_acpi_ec3: espi_acpi_ec3 {
+	ldn = <5>;
+	host-address = <0>;
+	sirqs = <0xff>;
+	sirq-names = "ec_obf";
+	status = "disabled";
+};
+espi_acpi_ec4: espi_acpi_ec4 {
+	ldn = <6>;
+	host-address = <0>;
+	sirqs = <0xff>;
+	sirq-names = "ec_obf";
+	status = "disabled";
