+#define MEC5_DT_ESPI_HD_NODE DT_PATH(mchp_mec5_espi_host_dev)
+#define MEC5_DT_ESPI_SB_NODE DT_PATH(mchp_mec5_espi_sram_bars)
+
+#define MEC5_ESPI_SB_ENTRY(node_id) \
