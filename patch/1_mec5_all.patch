+		.sram_base = DT_PROP(node_id, region_base), \
+		.sram_size = DT_ENUM_IDX(node_id, region_size), \
+		.access = DT_ENUM_IDX(node_id, access), \
+		.bar_id = DT_PROP(node_id, id), \
+	},
+
