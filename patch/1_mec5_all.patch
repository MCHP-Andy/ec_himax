@@ -0,0 +1,27 @@
+# Copyright (c) 2024 Microchip Technology Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+if BOARD_MEC_ASSY6906_MECH1723NSZ || BOARD_MEC_ASSY6906_MECH1723NLJ
+
+if RTOS_TIMER
+config SYS_CLOCK_HW_CYCLES_PER_SEC
+	default 32768
+
+config SYS_CLOCK_TICKS_PER_SEC
+	default 32768
+
+endif # RTOS_TIMER
+
+if !RTOS_TIMER
+# Use ARM Cortex-M SYSTICK. SYSTICK frequency is 96 MHz divided down by the MEC174x PCR
+# processor clock divider register. Boot-ROM sets PCR processor clock divider to 1.
+# Refer to SOC_MEC_PROC_CLK_DIV
+#
+config SYS_CLOCK_HW_CYCLES_PER_SEC
+	default 96000000
+
+config SYS_CLOCK_TICKS_PER_SEC
+	default 1000
+
+endif # !RTOS_TIMER
+endif # BOARD_MEC_ASSY6906_MECH1723NSZ or _MECH1723NLJ
