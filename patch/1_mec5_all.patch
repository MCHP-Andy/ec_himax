 dts/arm/microchip/mec5.dtsi                |   8 +
 dts/bindings/gpio/microchip,mec5-gpio.yaml |  29 ++
 6 files changed, 573 insertions(+)
 create mode 100644 drivers/gpio/Kconfig.mec5
 create mode 100644 drivers/gpio/gpio_mchp_mec5.c
 create mode 100644 dts/bindings/gpio/microchip,mec5-gpio.yaml

