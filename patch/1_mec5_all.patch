+		mec_hal_espi_ld_sirq_set(MEC_ESPI_IO, devcfg->ldn, 1, slot);
+	}
+
+	if (flags & MCHP_ESPI_PC_MBOX_IEN_FLAG_H2EC) {
+		ret = mec_hal_mbox_girq_ctrl(regs, enable);
+		if (ret != MEC_RET_OK) {
+			ret = -EIO;
+		}
 	}
 
 	return ret;
