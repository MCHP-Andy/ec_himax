+#ifndef __SAMPLES_BOARDS_MEC_ASSY6941_ESPI_HC_EMU_H_
+#define __SAMPLES_BOARDS_MEC_ASSY6941_ESPI_HC_EMU_H_
+
+#include <stdint.h>
+#include <stddef.h>
+
+int espi_hc_emu_init(uint32_t freqhz);
+int espi_hc_emu_espi_reset_n(uint8_t level);
+int espi_hc_emu_vcc_pwrgd(uint8_t level);
