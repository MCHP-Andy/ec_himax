+ * Include this file in the soc {} section in the relevant chip DTSI files
+ */
+gpspi0: spi@40009400 {
+	reg = <0x40009400 0x80>;
+	interrupts = <92 2>;
+	status = "disabled";
+};
+
+gpspi1: spi@40009480 {
+	reg = <0x40009480 0x80>;
+	interrupts = <94 2>;
+	status = "disabled";
+};
