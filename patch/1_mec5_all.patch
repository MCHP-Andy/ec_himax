+	status = "okay";
+};
+/* eSPI memory component I/O BAR */
+espi_mem: espi_mem {
+	ldn = <0x0e>;
+	host-address = <0>;
+	status = "okay";
+};
+espi_mbox0: espi_mbox0 {
+	ldn = <0>;
+	host-address = <0>;
+	sirqs = <0xff 0xff>;
+	sirq-names = "mbox_sirq", "mbox_smi";
+	status = "disabled";
+};
+espi_kbc0: espi_kbc0 {
+	ldn = <1>;
+	host-address = <0x60>;
+	sirqs = <0xff 0xff>;
+	sirq-names = "kirq", "mirq";
+	status = "disabled";
+};
+espi_acpi_ec0: espi_acpi_ec0 {
