@@ -0,0 +1,4 @@
+# To test the counter driver for MCHP RTOS timer and basic timer 5
+# we must switch rtimer to use the counter driver which requires
+# switching kernel to use ARM SysTick.
+CONFIG_RTOS_TIMER=n
diff --git a/tests/drivers/counter/counter_basic_api/boards/mec_assy6906_mech1723nsz.overlay b/tests/drivers/counter/counter_basic_api/boards/mec_assy6906_mech1723nsz.overlay
