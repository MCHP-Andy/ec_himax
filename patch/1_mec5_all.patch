+# Microchip MEC5 HAL ADC SAR configuration
+
+# Copyright (c) 2024 Microchip Technology Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+config ADC_MEC5_SAR
+	bool "Microchip MEC5 HAL based ADC SAR driver"
+	default y
