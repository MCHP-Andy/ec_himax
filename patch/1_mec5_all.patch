diff --git a/samples/boards/mchp_mec5/i2c/app.overlay b/samples/boards/mchp_mec5/i2c/app.overlay
index d4f303fb417..df423802027 100644
--- a/samples/boards/mchp_mec5/i2c/app.overlay
