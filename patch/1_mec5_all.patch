+}
+#endif
+
 /* -------- ACPI EC -------- */
+
+#define MCHP_ESPI_AEC_EV_FLAG_4BYTE	BIT(0)
+
+#define MCHP_ESPI_AEC_EV_NONE		0
+#define MCHP_ESPI_AEC_EV_CMD		1
